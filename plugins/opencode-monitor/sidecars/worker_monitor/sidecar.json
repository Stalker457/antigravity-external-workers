{
  "command": "node",
  "args": ["main.mjs"],
  "restart_policy": "always",
  "display_name": "OpenCode Monitor",
  "description": "Real-time auxiliary panel for monitoring OpenCode / DeepSeek worker progress, Task Specs, tools, and token usage.",
  "has_web_ui": true,
  "agent_permissions": {
    "allows_user_interactions": false
  },
  "ui_config": {
    "display_name": "OpenCode Monitor",
    "views": [
      {
        "path": "/",
        "entrypoint": "SIDECAR_UI_ENTRYPOINT_AUX_PANE",
        "title": "OpenCode Monitor"
      }
    ]
  }
}
